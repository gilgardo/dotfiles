(defcfg
  process-unmapped-keys yes
)

(defsrc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]
  caps a    s    d    f    g    h    j    k    l    ;    '
  lsft nubs z    x    c    v    b    n    m    ,    .    /    rsft
       lmet lalt      spc            ralt
)

;; Chords: g+h = Enter
(defchords homerow 50
  (g) g
  (h) h
  (g h) ret
)

(defalias
  ;; HOME ROW MODS
  ;; Left Hand
  a_alt (tap-hold 200 200 a lalt)
  s_met (tap-hold 200 200 s lmet)
  d_ctl (tap-hold 200 200 d lctl)
  f_sft (tap-hold 200 200 f lsft)

  ;; Right Hand
  j_sft (tap-hold 200 200 j rsft)
  k_ctl (tap-hold 200 200 k rctl)
  l_met (tap-hold 200 200 l rmet)
  ;_alt (tap-hold 200 200 ; lalt)

  ;; g and h for chord (Enter)
  g_chd (chord homerow g)
  h_chd (chord homerow h)

  ;; Caps: tap = esc, hold = tab
  cap_esc (tap-hold 150 150 esc tab)

  ;; v and m: tap = letter, hold = symbol layer
  v_sym (tap-hold 200 200 v (layer-toggle symbols))
  m_sym (tap-hold 200 200 m (layer-toggle symbols))

  ;; nubs: tap = tab, hold = F-keys layer
  nubs_fn (tap-hold 200 200 tab (layer-toggle fkeys))

  ;; Space: tap = space, hold = numpad layer
  spc_num (tap-hold 200 200 spc (layer-toggle numpad))

  ;; Shift keys
  lsft_sym (tap-hold 200 200 lsft (layer-toggle symbols))

  ;; E: tap = e, hold = nav layer
  e_nav (tap-hold 200 200 e (layer-toggle nav))

  ;; N: tap = n, hold = backspace
  n_bspc (tap-hold 200 200 n bspc)

  ;; Hold RAlt for Italian Accents
  ita_mod (layer-toggle italian)
)

(deflayer base
  tab  q    w    @e_nav r    t    y    u    i    o    p    [    ]
  @cap_esc @a_alt @s_met @d_ctl @f_sft @g_chd @h_chd @j_sft @k_ctl @l_met @;_alt '
  @lsft_sym @nubs_fn z    x    c    @v_sym b    @n_bspc @m_sym ,    .    /    (caps-word 2000)
       lmet lalt      @spc_num       @ita_mod
)

;; NUMPAD LAYER - numbers only (hold spacebar)
;;     u i o        7 8 9
;;     j k l    →   4 5 6
;;     m , . /      1 2 3 0
(deflayer numpad
  _    _    _    _    _    _    _    7    8    9    _    _    _
  _    _    _    _    _    _    _    4    5    6    _    _
  _    _    _    _    _    _    _    _    1    2    3    0    _
       _    _         _              _
)

;; Symbol layer (hold v or m)
;; Top row: ! @ # $ % ^ & * \ |  ` ~
;; Home row: [ ] ( ) on left, + - = _ on right
;; x = {, c = }
(deflayer symbols
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  \    S-\  grv  S-grv
  _    _    [    ]    S-9  S-0  _    S-=  -    =    S--  _
  _    _    _    S-[  S-]  _    _    _    _    _    _    _    _
       _    _         _              _
)

;; Navigation layer (hold e)
;; Left hand: q=Esc w=C-w r=C-r t=C-t (vim shortcuts)
;; Right hand: hjkl=arrows, ;=bspc '=del, uiop=home/pgup/end/pgdn
(deflayer nav
  _    esc  C-w  _    C-r  C-t  _    home pgup end  pgdn _    _
  _    _    _    C-d  _    _    left down up   rght bspc del
  _    _    C-z  C-x  C-c  C-v  _    _    _    _    _    _    _
       _    _         _              _
)

;; F-keys layer (hold nubs/tab key)
;; Top row: F1-F10, [ = F11, ] = F12
;; Home row: media controls
(deflayer fkeys
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    _    _    _    _    prev vold volu next pp   _
  _    _    _    _    _    _    _    _    mute _    _    _    _
       _    _         _              _
)

(deflayer italian
  _    _    _    (unicode è) _    _    _    (unicode ù) (unicode ì) (unicode ò) _    _    _
  _    (unicode à) _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
       _    _         _              _
)
